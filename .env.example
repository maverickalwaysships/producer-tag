# ============================================================================
# .env.example – Template for Git Push Producer Tag configuration
# ============================================================================
# Copy this file to .env and adjust paths to match your machine:
#   cp .env.example .env
#
# ⚠  Never commit .env – it contains local paths specific to your machine.
# ℹ  Supported audio format: MP3 (played via macOS afplay).
# ============================================================================

# Directory where the Git wrapper script lives
WRAPPER_DIR="$HOME/.local/bin"

# Full path to the Git wrapper script
WRAPPER_PATH="$HOME/.local/bin/git"

# Directory that holds your audio files
SOUNDS_DIR="$HOME/.git-sounds"

# Path to the producer tag MP3 that plays after every successful git push
AUDIO_FILE="$HOME/.git-sounds/push.mp3"

# Shell config file (used to add the wrapper to PATH)
ZSHRC="$HOME/.zshrc"

# Editor settings files (adjust if your editors are installed elsewhere)
CURSOR_SETTINGS="$HOME/Library/Application Support/Cursor/User/settings.json"
ANTIGRAVITY_SETTINGS="$HOME/Library/Application Support/Antigravity IDE/User/settings.json"
